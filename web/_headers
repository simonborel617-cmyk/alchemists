# Cloudflare Pages headers. HTML and scripts revalidate on every load (assets are cache-busted with ?v=);
# metadata and art are public, cacheable and CORS-open for wallets, explorers and marketplaces.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cache-Control: no-cache
/metadata/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=86400
/img/*
  Cache-Control: public, max-age=86400
