# /etc/systemd/system/alchemists-watch.service: needs no key, only KEEPER_ADDRESS (and the alert settings) in .env
[Unit]
Description=Alchemists watcher (alerts: no ticks, keeper balance, pause, RPC)
After=network-online.target
Wants=network-online.target

[Service]
User=alchemists
WorkingDirectory=/opt/alchemists-keeper
Environment=NET=robinhood
Environment=WATCH_MIN_BALANCE=0.005
ExecStart=/opt/alchemists-keeper/node/bin/node scripts/watch.js
Restart=always
RestartSec=10
StandardOutput=append:/var/log/alchemists/watch.log
StandardError=append:/var/log/alchemists/watch.log

[Install]
WantedBy=multi-user.target
